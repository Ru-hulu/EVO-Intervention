# Copy to .env in this directory and fill in. annotate.py reads .env (or --env-file); environment variables
# and command-line flags override it. .env is gitignored, so the API key stays local.

# OpenAI-compatible endpoint serving a vision-language model, e.g. vLLM at http://localhost:8000/v1.
ANNOTATOR_BASE_URL=http://localhost:8000/v1
ANNOTATOR_API_KEY=
ANNOTATOR_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct

# Maximum sampled frames per stage (planning and localization sample separately).
ANNOTATOR_NUM_FRAMES=128
ANNOTATOR_MAX_SIDE=448

ANNOTATOR_MAX_TOKENS=4096
# Seconds per API request.
ANNOTATOR_TIMEOUT=300
# Re-asks when the localization answer is invalid.
ANNOTATOR_RETRIES=2
